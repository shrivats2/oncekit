{
  "name": "oncekit",
  "version": "0.1.0",
  "description": "Exactly-once processing for webhooks, events, and jobs. Dedupe, crash recovery, and dead-letter handling in one call.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./postgres": {
      "types": "./dist/stores/postgres.d.ts",
      "import": "./dist/stores/postgres.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "idempotency",
    "idempotent",
    "exactly-once",
    "at-least-once",
    "webhooks",
    "webhook",
    "dead-letter",
    "deduplication",
    "dedupe",
    "reliability",
    "events",
    "queue",
    "outbox",
    "stripe"
  ],
  "author": "Shrivats Shrivastav (https://github.com/shrivats2)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shrivats2/oncekit.git"
  },
  "homepage": "https://github.com/shrivats2/oncekit#readme",
  "bugs": {
    "url": "https://github.com/shrivats2/oncekit/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/pg": "^8.20.0",
    "pg": "^8.22.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "pg": "^8.0.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  }
}
